# Cozybat — réglages serveur (Apache / LiteSpeed — Hostinger)
Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# 0. Fichiers du dépôt Git jamais servis (sources, historique)
RewriteRule ^(\.git|\.github|_build)(/|$) - [F,L]
RewriteRule ^(README\.md|\.gitignore)$ - [F,L]

# 1. HTTPS obligatoire et domaine sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://cozybat.fr%{REQUEST_URI} [L,R=301]

# 2. Anciennes adresses du site
RewriteRule ^chantiers\.html$ /nos-realisations/ [R=301,L]
RewriteRule ^(peinture|nettoyage)-facade(\.html)?/?$ /ravalement-facade/ [R=301,L]
RewriteRule ^chantiers/ite-ollainville(\.html)?/?$ /chantiers/isolation-exterieure-ollainville/ [R=301,L]
RewriteRule ^assets/img/chantiers/ite-ollainville-(avant|apres)\.webp$ /assets/img/chantiers/isolation-exterieure-ollainville-$1.webp [R=301,L]
RewriteRule ^chantiers/ite-saint-michel-sur-orge(\.html)?/?$ /chantiers/isolation-exterieure-saint-michel-sur-orge/ [R=301,L]
RewriteRule ^assets/img/chantiers/ite-saint-michel-sur-orge-(avant|apres)\.webp$ /assets/img/chantiers/isolation-exterieure-saint-michel-sur-orge-$1.webp [R=301,L]
RewriteRule ^chantiers/ite-lucarnes-sainte-genevieve-des-bois(\.html)?/?$ /chantiers/isolation-lucarnes-sainte-genevieve-des-bois/ [R=301,L]
RewriteRule ^assets/img/chantiers/ite-lucarnes-sainte-genevieve-des-bois-(avant|apres)\.webp$ /assets/img/chantiers/isolation-lucarnes-sainte-genevieve-des-bois-$1.webp [R=301,L]
RewriteRule ^chantiers/ravalement-morangis(\.html)?/?$ /chantiers/ravalement-facade-morangis/ [R=301,L]
RewriteRule ^assets/img/chantiers/ravalement-morangis-(avant|apres)\.webp$ /assets/img/chantiers/ravalement-facade-morangis-$1.webp [R=301,L]
RewriteRule ^chantiers/ravalement-yerres(\.html)?/?$ /chantiers/ravalement-facade-yerres/ [R=301,L]
RewriteRule ^assets/img/chantiers/ravalement-yerres-(avant|apres)\.webp$ /assets/img/chantiers/ravalement-facade-yerres-$1.webp [R=301,L]
RewriteRule ^chantiers/ravalement-brunoy(\.html)?/?$ /chantiers/ravalement-facade-brunoy/ [R=301,L]
RewriteRule ^assets/img/chantiers/ravalement-brunoy-(avant|apres)\.webp$ /assets/img/chantiers/ravalement-facade-brunoy-$1.webp [R=301,L]
RewriteRule ^chantiers/?$ /nos-realisations/ [R=301,L]
RewriteRule ^assets/img/equipe-cozybat\.webp$ /assets/img/equipe-cozybat-facadiers-morangis.webp [R=301,L]
RewriteRule ^assets/js/main\.js$ /assets/js/site.js [R=301,L]

# 3. /index.html -> /  et  /page/index.html -> /page/
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Anciennes pages en .html -> nouvelle adresse /page/ (seulement si la nouvelle page existe)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^ /%1/ [R=301,L]
</IfModule>

# Compression
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml application/json application/manifest+json text/xml application/xml
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/manifest+json text/xml application/xml
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType application/manifest+json "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(webp|png|jpe?g|ico|woff2|css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
